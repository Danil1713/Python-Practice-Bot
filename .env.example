# Telegram
BOT_TOKEN=

# PostgreSQL
POSTGRES_DB=python_practice
POSTGRES_USER=python_practice
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433

# Local application connection.
# Docker Compose overrides DATABASE_URL for bot/migrate containers.
DATABASE_URL=postgresql+asyncpg://python_practice:change_me@localhost:5433/python_practice

# Redis
# Docker Compose overrides this for the bot container.
REDIS_URL=redis://localhost:6379/0

# AI providers
# Сейчас используется Gemini.
# OPENAI_API_KEY зарезервирован для будущего перехода на OpenAI.
GEMINI_API_KEY=
OPENAI_API_KEY=

AI_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=45
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_SECONDS=1
AI_MAX_CONCURRENCY=2

# Admin
ADMIN_TELEGRAM_IDS=
ADMIN_USERNAME=

# Application
APP_TIMEZONE=Europe/Moscow

# Tests
TEST_DATABASE_URL=postgresql+asyncpg://python_practice:change_me@localhost:5433/python_practice_test